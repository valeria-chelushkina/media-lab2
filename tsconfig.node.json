{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vitest.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/core/**/*",
    "src/shared/**/*",
    "scripts/**/*",
    "tests/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@core": ["./src/core/index.ts"],
      "@core/*": ["./src/core/*"],
      "@shared/*": ["./src/shared/*"],
      "@resources/*": ["./resources/*"]
    }
  }
}
